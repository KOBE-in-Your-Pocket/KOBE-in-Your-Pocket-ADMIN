# 本番ビルド時の API ベース URL（末尾スラッシュなし）
# 未設定時は同一オリジン（dev では Vite プロキシ /api 経由）
# VITE_API_BASE_URL=https://api.example.com

# dev プロキシの転送先（pnpm dev 起動時のみ）
# VITE_PROXY_TARGET=http://localhost:9090

# 実 API 未接続の画面（ダッシュボード / レビュー / ユーザー）を mock 表示にする。
# 通常はこのファイルで設定せず、`pnpm dev:mock` / `pnpm build:mock` を使う
# （`.env.mock` が読まれる）。既定は準備中画面。
# VITE_ENABLE_MOCK_SCREENS=true
